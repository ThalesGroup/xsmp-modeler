catalogue UnaryOperators
namespace unary {
    /** @uuid a1100000-0000-4000-8000-000000000001 */
    public struct Values {
        constant Int32 Base = 7
        constant Int32 DoubleMinus = - -1
        constant Int32 TripleMinus = - - -1
        constant Int32 DoublePlus = + +Base
        constant Int32 Mixed = - +1
